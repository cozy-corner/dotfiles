keybind = global:cmd+grave_accent=toggle_quick_terminal

# cursor-agent CLI mishandles raw ^H (0x08); send DEL instead, same as physical Backspace
keybind = ctrl+h=text:\x7f

# Color theme
theme = Kanagawa Wave

# Font size
font-size = 20

# Re-enable discretionary ligatures (default-off since 1.2.0)
font-feature = dlig

# Hide traffic light buttons
macos-window-buttons = hidden

# Custom shaders (applied in order — cursor effect, then screen post-FX)
# Source: https://github.com/KroneCorylus/ghostty-shader-playground

# Active: restrained Kanagawa-tuned smear + subtle bloom + film grain/vignette
custom-shader = ~/.config/ghostty/shaders/kanagawa/cursor_smear.glsl
custom-shader = ~/.config/ghostty/shaders/kanagawa/bloom.glsl
custom-shader = ~/.config/ghostty/shaders/kanagawa/film_grain_vignette.glsl

# --- Alternatives from playground/ (uncomment one cursor shader at a time) ---
# Previous cursor look: yellow smear with fade
# custom-shader = ~/.config/ghostty/shaders/playground/cursor_smear_fade.glsl
# Simple smear effect
# custom-shader = ~/.config/ghostty/shaders/playground/cursor_smear.glsl
# Tapered blaze (flashy)
# custom-shader = ~/.config/ghostty/shaders/playground/cursor_blaze_tapered.glsl
# Gradient with animation (very flashy)
# custom-shader = ~/.config/ghostty/shaders/playground/cursor_smear_gradient.glsl
# Full blaze (very flashy)
# custom-shader = ~/.config/ghostty/shaders/playground/cursor_blaze.glsl
