{
  "arch": "aarch64",
  "distro": "alpine",
  "alpine": {
    "version": "3.23.0",
    "kernelPackage": "linux-virt",
    "kernelImage": "vmlinuz-virt",
    "krunfwVersion": "v5.2.1"
  },
  "oci": {
    "image": "pi-guest:latest",
    "runtime": "docker",
    "pullPolicy": "never"
  },
  "rootfs": {
    "label": "gondolin-root",
    "sizeMb": 10240
  },
  "env": [
    "PATH=/usr/local/cargo/bin:/usr/local/share/nvm/current/bin:/usr/local/go/bin:/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "GOROOT=/usr/local/go",
    "GOPATH=/go",
    "NVM_DIR=/usr/local/share/nvm",
    "NVM_SYMLINK_CURRENT=true",
    "CARGO_HOME=/usr/local/cargo",
    "RUSTUP_HOME=/usr/local/rustup"
  ]
}
