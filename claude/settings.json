{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "advisorModel": "fable",
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "enableAllProjectMcpServers": false,
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "mapo-aidd@bill-one-marketplace": true,
    "mapo-git@bill-one-marketplace": true,
    "mapo-implementation-rules@bill-one-marketplace": true,
    "mapo-tools@bill-one-marketplace": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "serena@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "superpowers@superpowers-marketplace": true,
    "typescript-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "autoUpdate": true,
      "source": {
        "repo": "obra/superpowers-marketplace",
        "source": "github"
      }
    }
  },
  "feedbackSurveyState": {
    "lastShownTime": 1754269096080
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "ignorePatterns": [
    "*.ear",
    "*.iml",
    "*.jar",
    "*.log",
    "*.war",
    ".gradle/",
    ".idea/",
    "build/",
    "coverage/",
    "node_modules/",
    "out/",
    "target/"
  ],
  "permissions": {
    "allow": [
      "Bash(*)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Edit",
      "Glob",
      "Grep",
      "LSP",
      "Read",
      "WebFetch",
      "WebSearch",
      "Write",
      "mcp__chrome-devtools__close_page",
      "mcp__chrome-devtools__get_console_message",
      "mcp__chrome-devtools__get_network_request",
      "mcp__chrome-devtools__list_console_messages",
      "mcp__chrome-devtools__list_network_requests",
      "mcp__chrome-devtools__list_pages",
      "mcp__chrome-devtools__navigate_page",
      "mcp__chrome-devtools__resize_page",
      "mcp__chrome-devtools__select_page",
      "mcp__chrome-devtools__take_screenshot",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__chrome-devtools__wait_for",
      "mcp__notion__*",
      "mcp__obsidian-mcp-tools__*"
    ],
    "ask": [
      "Bash(brew install *)",
      "Bash(brew remove *)",
      "Bash(brew uninstall *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(gh api --method PATCH *)",
      "Bash(gh api --method POST *)",
      "Bash(gh api --method PUT *)",
      "Bash(gh api --method=PATCH *)",
      "Bash(gh api --method=POST *)",
      "Bash(gh api --method=PUT *)",
      "Bash(gh api -X PATCH *)",
      "Bash(gh api -X POST *)",
      "Bash(gh api -X PUT *)",
      "Bash(gh issue close*)",
      "Bash(gh issue create*)",
      "Bash(gh issue edit*)",
      "Bash(gh pr close*)",
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr merge*)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git clean*)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git restore*)",
      "Bash(npm install -g *)",
      "Bash(npm uninstall *)",
      "Bash(pip install *)",
      "Bash(pip uninstall *)",
      "Bash(pnpm add -g *)",
      "Bash(pnpm install -g *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm uninstall *)",
      "Bash(rm -rf *)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(find * -delete)",
      "Bash(find * -exec bash *)",
      "Bash(find * -exec chmod *)",
      "Bash(find * -exec chown *)",
      "Bash(find * -exec mv *)",
      "Bash(find * -exec rm *)",
      "Bash(find * -exec sh *)",
      "Bash(find * -execdir bash *)",
      "Bash(find * -execdir chmod *)",
      "Bash(find * -execdir chown *)",
      "Bash(find * -execdir mv *)",
      "Bash(find * -execdir rm *)",
      "Bash(find * -execdir sh *)",
      "Bash(gh api --method DELETE *)",
      "Bash(gh api --method=DELETE *)",
      "Bash(gh api -X DELETE *)",
      "Bash(git config --global *)",
      "Bash(git config --system *)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(sudo *)"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "bash ~/.claude/statusline-command.sh",
    "padding": 0,
    "type": "command"
  },
  "theme": "dark-daltonized",
  "tui": "default"
}
