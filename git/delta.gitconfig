[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	hunk-header-style = omit
	syntax-theme = kanagawa
	minus-style = syntax "#43242b"
	minus-emph-style = syntax "#c34043"
	plus-style = syntax "#2b3328"
	plus-emph-style = syntax "#76946a"
